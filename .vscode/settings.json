{
  "github-actions.workflows.pinned.workflows": [".github/workflows/ci.yml"],
  "chat.tools.terminal.autoApprove": {
    "/^bash \\.claude/skills/update-docs/scripts/check-version\\.sh$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^bash \\.claude/skills/update-docs/scripts/find-diff\\.sh$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "oxc.enable": true,
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "oxc.fmt.configPath": "./vite.config.ts",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },
  "js/ts.hover.maximumLength": 100000
}
